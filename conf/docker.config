/*
================================================================================
  docker.config
================================================================================
  Activated with: -profile docker
  Requires Docker daemon to be running locally.

  Uses params.docker_image from nextflow.config by default.
  Default registry image:
    ghcr.io/kaiyao28/genetic-qc:1.1
  Override for local builds:
    --docker_image genetic-qc:1.1
================================================================================
*/

docker {
    enabled    = true
    // Run as the host user so output files are owned by the user, not root.
    // HOME=/tmp prevents R/rmarkdown from writing to /root when uid has no
    // /etc/passwd entry (common on CI runners like GitHub Actions).
    runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'
}

// Mount the working directory automatically (Nextflow does this by default,
// but explicit runOptions can override it — keep enabled)
process {
    container = params.docker_image
}

// Cap resources for local Docker runs (override in site-specific config for HPC)
params {
    max_memory = "6.GB"
    max_cpus   = 4
    max_time   = "24.h"
}
